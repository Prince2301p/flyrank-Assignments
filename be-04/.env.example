# Application Environment Configuration Example
PORT=3000
STORAGE_TYPE=postgres

# PostgreSQL Connection String (Use 'db' hostname in Docker, 'localhost' for local host execution)
DATABASE_URL=postgres://postgres:postgres@db:5432/taskdb

# PostgreSQL Container Setup Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskdb

# Redis Connection String (Use 'redis' hostname in Docker, 'localhost' for local host execution)
REDIS_URL=redis://redis:6379
